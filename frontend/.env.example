# Copy this file to .env and fill in the values

# ── API URL ───────────────────────────────────────────────────────────────────
# Production (Render fullstack — frontend served by same Express server):
VITE_API_URL=/api

# Local dev (frontend runs separately on Vite dev server):
# VITE_API_URL=http://localhost:5008/api

# ── Paystack ──────────────────────────────────────────────────────────────────
VITE_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# ── Google OAuth ──────────────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_ADMIN_EMAIL=your_admin_email_here
